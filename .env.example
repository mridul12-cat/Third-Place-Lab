QLOO_MODE=mock
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
# All application live mode requires this switch and a migrated shared budget store.
# Keep false pending release approval. Native Next uses Turso; Sites rollback uses DB.
QLOO_PUBLIC_LIVE_ENABLED=false
# Proposed conservative launch limits; owner must approve against actual account quota.
QLOO_DAILY_REQUEST_LIMIT=100
QLOO_MINUTE_REQUEST_LIMIT=20
# Native Next.js: exact browser origin. Use HTTPS on the public deployment.
APP_ORIGIN=http://localhost:3000
# Server-only remote libSQL configuration; no local file/replica fallback.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
